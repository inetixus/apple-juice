# ── Apple Juice environment variables ──
# Copy this file to .env.local and fill in real values. Never commit .env.local.

# ── Kiro shared-credit inference (powers the Free/Pro/Ultra plans) ──
# API key generated from the Kiro console (Settings → Enable API keys).
KIRO_API_KEY=
# OpenAI-compatible Chat Completions base URL for Kiro inference.
# Defaults to https://api.kiro.dev/v1 if unset.
KIRO_API_URL=https://api.kiro.dev/v1
# Optional: Stage 2 agentic generation via the VPS proxy (filesystem-based).
# Same base as KIRO_API_URL; the app appends /agent. Leave unset to disable.
KIRO_AGENT_URL=

# ── Auth (NextAuth) ──
NEXTAUTH_SECRET=
ROBLOX_CLIENT_ID=
ROBLOX_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET_OAUTH=

# ── Database (Turso / libSQL) — sessions, usage, projects ──
# Create a DB at https://turso.tech then run: turso db show <name> --url
# and: turso db tokens create <name>
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ── Optional: legacy/custom provider keys (only for users supplying their own) ──
OPENAI_API_KEY=
GOOGLE_API_KEY=

# ── Redeem codes ──
REDEEM1=refresh

# ── Partner program (invite-only) ──
# Private code that grants the Partner plan (between Free and Pro). Hand this out
# per partnership. Leave UNSET to disable the partner path entirely — there is no
# default, so the plan can't be self-granted by guessing.
PARTNER_CODE=

# ── Admin ──
# Comma-separated user IDs allowed to use privileged endpoints (e.g. the
# /api/usage plan/balance override + debug buttons). Leave UNSET so nobody can
# self-upgrade — real plan grants come from the Roblox webhook / redeem codes.
ADMIN_USER_IDS=

# ── Roblox purchase webhook (in-game ProcessReceipt → grant plan/refill) ──
# Shared secret the Roblox game server sends so we trust its purchase callbacks.
ROBLOX_WEBHOOK_SECRET=

# ── Roblox subscription verification (Open Cloud) ──
# Used by /api/verify-subscription + /api/account/status to confirm a user's
# web subscription purchase directly with Roblox and grant the plan. The key
# needs the universe.subscription-product.subscription:read scope.
ROBLOX_OPEN_CLOUD_KEY=
ROBLOX_UNIVERSE_ID=

# ── Metering ──
# mL of Juice charged per real Kiro credit when the proxy reports actual credit
# usage (agent / MCP paths). Anchors billing to ground-truth cost. Defaults to
# 1000 (1 credit ≈ 1000 mL). Tune against your real cost-per-credit + margin.
ML_PER_KIRO_CREDIT=1000
