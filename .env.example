# ── Apple Juice environment variables ──
# Copy this file to .env.local and fill in real values. Never commit .env.local.

# ── Kiro shared-credit inference (powers the Free/Pro/Ultra plans) ──
# API key generated from the Kiro console (Settings → Enable API keys).
KIRO_API_KEY=
# OpenAI-compatible Chat Completions base URL for Kiro inference.
# Defaults to https://api.kiro.dev/v1 if unset.
KIRO_API_URL=https://api.kiro.dev/v1

# ── Auth (NextAuth) ──
NEXTAUTH_SECRET=
ROBLOX_CLIENT_ID=
ROBLOX_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET_OAUTH=

# ── Redis (Upstash) — sessions, usage, projects ──
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── Optional: legacy/custom provider keys (only for users supplying their own) ──
OPENAI_API_KEY=
GOOGLE_API_KEY=

# ── Redeem codes ──
REDEEM1=refresh
