{
  "manifest_version": 3,
  "name": "Apple Juice Purchase Sync",
  "version": "1.0.0",
  "description": "Detects your Apple Juice plan/refill purchases on Roblox and unlocks them on apple-juice.online automatically.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.roblox.com/*",
    "https://apple-juice.online/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.roblox.com/*"],
      "js": ["roblox-detect.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Apple Juice Purchase Sync"
  },
  "web_accessible_resources": [
    {
      "resources": ["inject.js"],
      "matches": ["https://www.roblox.com/*"]
    }
  ]
}
